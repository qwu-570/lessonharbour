# Supabase project configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Never expose this value in browser code or commit it.
SUPABASE_SECRET_KEY=

# Optional translation provider. Without this, published biographies use MyMemory.
DEEPL_API_KEY=

# Transactional booking email. Requires an onboarded sender domain.
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
EMAIL_FROM=notifications@example.com
SITE_URL=https://lessonharbour-live-mvp.qling-wu.chatgpt.site
